# MEXC API Credentials
MEXC_API_KEY=your_api_key_here
MEXC_SECRET_KEY=your_secret_key_here

# Trading Configuration
TRADING_SYMBOL=BTCUSDT
TRADING_STRATEGY=grid        # grid | ma | vwap-rsi
QUOTE_ASSET=USDT             # Quote asset used to check balance

# Grid Strategy Settings
GRID_UPPER_PRICE=70000
GRID_LOWER_PRICE=60000
GRID_LEVELS=10
GRID_ORDER_AMOUNT=0.001      # Amount per grid order in base asset (e.g. BTC)

# Moving Average Strategy Settings
MA_SHORT_PERIOD=9
MA_LONG_PERIOD=21
MA_INTERVAL=1h               # Kline interval: 1m, 5m, 15m, 30m, 1h, 4h, 1d
MA_ORDER_AMOUNT=0.001

# VWAP + RSI Strategy Settings
VWAP_RSI_INTERVAL=15m        # Kline interval: 1m, 5m, 15m, 30m, 1h, 4h, 1d
VWAP_RSI_MODE=reversion      # reversion | momentum
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
VWAP_TOLERANCE=0.5           # % distance from VWAP to consider price "near" it
VWAP_RSI_ORDER_AMOUNT=0.001

# Risk Management
MAX_OPEN_ORDERS=20
DRY_RUN=true                 # Set to false to place real orders

# ── Alerts ─────────────────────────────────────────────────────────────────
# Leave blank to disable a channel.

# Telegram — get token from @BotFather, chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord webhook — Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_TO=

# Generic HTTP webhook (POST JSON payload)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=        # Sent as X-Bot-Secret header

# Logging
LOG_LEVEL=info               # error | warn | info | debug
