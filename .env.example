# MEXC API Credentials
MEXC_API_KEY=your_api_key_here
MEXC_SECRET_KEY=your_secret_key_here

# Trading Configuration
TRADING_SYMBOL=BTCUSDT
TRADING_STRATEGY=grid        # grid | ma | vwap-rsi

# Grid Strategy Settings
GRID_UPPER_PRICE=70000
GRID_LOWER_PRICE=60000
GRID_LEVELS=10
GRID_ORDER_AMOUNT=0.001      # Amount per grid order in base asset

# Moving Average Strategy Settings
MA_SHORT_PERIOD=9
MA_LONG_PERIOD=21
MA_INTERVAL=1h               # Kline interval: 1m, 5m, 15m, 30m, 1h, 4h, 1d
MA_ORDER_AMOUNT=0.001

# VWAP + RSI Strategy Settings
VWAP_RSI_INTERVAL=15m        # Kline interval: 1m, 5m, 15m, 30m, 1h, 4h, 1d
VWAP_RSI_MODE=reversion      # reversion | momentum
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
VWAP_TOLERANCE=0.5           # % distance from VWAP to consider price "near" it
VWAP_RSI_ORDER_AMOUNT=0.001

# Risk Management
MAX_OPEN_ORDERS=20
DRY_RUN=true                 # Set to false to place real orders

# Logging
LOG_LEVEL=info               # error | warn | info | debug
